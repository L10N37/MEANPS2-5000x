EESchema-LIBRARY Version 2.4
#encoding utf-8
#
# AC_INPUT_2
#
DEF AC_INPUT_2 J 0 40 Y Y 1 F N
F0 "J" 0 250 50 H V C CNN
F1 "AC_INPUT_2" 0 -250 50 H V C CNN
DRAW
S -100 150 100 -150 0 1 10 f
X LIVE 1 300 50 200 L 40 40 1 1 P
X NEUTRAL 2 300 -50 200 L 40 40 1 1 P
ENDDRAW
ENDDEF
#
# DONOR_FUSE
#
DEF DONOR_FUSE F 0 0 N Y 1 F N
F0 "F" 0 100 50 H V C CNN
F1 "T2AH/250V" 0 -100 50 H V C CNN
DRAW
P 2 0 1 12 -100 50 100 -50 N
P 2 0 1 12 -100 -50 100 50 N
X FUSED 1 300 0 200 L 40 40 1 1 P
X LINE 2 -300 0 200 R 40 40 1 1 P
ENDDRAW
ENDDEF
#
# IRM_45_60
#
DEF IRM_45_60 U 0 20 Y Y 1 F N
F0 "U" 0 300 50 H V C CNN
F1 "IRM-45-12 / IRM-60-12" 0 -300 50 H V C CNN
DRAW
S -300 250 300 -250 0 1 12 f
X AC/L 1 -500 150 200 R 40 40 1 1 W
X AC/N 2 -500 -150 200 R 40 40 1 1 W
X -V 3 500 -150 200 L 40 40 1 1 w
X +V 4 500 150 200 L 40 40 1 1 w
ENDDRAW
ENDDEF
#
# PS2_OUTPUT_4
#
DEF PS2_OUTPUT_4 J 0 40 Y Y 1 F N
F0 "J" 0 300 50 H V C CNN
F1 "PS2_OUTPUT_4" 0 -300 50 H V C CNN
DRAW
S -100 250 100 -250 0 1 10 f
X GND 1 -300 -150 200 R 40 40 1 1 P
X GND 2 -300 -50 200 R 40 40 1 1 P
X +12V 3 -300 50 200 R 40 40 1 1 P
X +12V 4 -300 150 200 R 40 40 1 1 P
ENDDRAW
ENDDEF
